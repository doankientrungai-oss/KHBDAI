# ==============================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG KHI TRIỂN KHAI TRÊN NETLIFY
# (Tất cả các biến này đều có thể cấu hình trong: Netlify Dashboard -> Site Configuration -> Environment Variables)
# ==============================================================

# 1. Google Gemini AI API Key (Tùy chọn nếu muốn cung cấp key mặc định cho cả trường/ứng dụng)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# 2. Cấu hình Firebase Authentication & Firestore (Đăng nhập Gmail & Phân quyền)
# Lấy tại Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
